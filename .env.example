# Copia este archivo como .env.local y completa los valores. .env.local no se sube al repositorio.

# Clave para abrir la sección Resultados. En local, si no se define, la clave es "clave-local".
# La clave de producción se configura en Vercel (Settings → Environment Variables), no aquí.
RESULTS_ACCESS_KEY=

# Solo si quieres probar contra el almacén Blob de Vercel desde tu equipo (normalmente no hace falta).
# BLOB_READ_WRITE_TOKEN=
